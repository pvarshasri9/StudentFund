// Production PostgreSQL Prisma Schema for StudentFund
// Designed for production deployments (e.g., Supabase, Neon, AWS RDS, Railway, Render, Docker)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String               @id @default(uuid())
  email            String               @unique
  password         String
  name             String
  college          String?
  course           String?
  currentSemester  Int?                 @default(1)
  monthlyAllowance Decimal?             @default(0) @db.Decimal(12, 2)
  currency         String               @default("INR")
  isDemo           Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  incomes          Income[]
  expenses         Expense[]
  budgets          Budget[]
  commitments      CollegeCommitment[]
  savingsGoals     SavingsGoal[]
  savingsLogs      SavingsContribution[]
  reminders        Reminder[]
  literacyProgress LiteracyProgress[]
  settings         UserSettings?

  @@index([email])
}

model UserSettings {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme               String   @default("dark")
  runwayBufferDays    Int      @default(30)
  enableAlerts        Boolean  @default(true)
  budgetWarningThresh Int      @default(80)
  currencySymbol      String   @default("₹")
  updatedAt           DateTime @updatedAt
}

model Income {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Decimal   @db.Decimal(12, 2)
  source       String
  description  String
  date         DateTime  @default(now())
  isExpected   Boolean   @default(false)
  receivedDate DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId, date])
  @@index([userId, isExpected])
}

model Expense {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Decimal   @db.Decimal(12, 2)
  category      String
  description   String
  date          DateTime  @default(now())
  isEssential   Boolean   @default(true)
  paymentMethod String    @default("UPI")
  notes         String?
  commitmentId  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, date])
  @@index([userId, category])
  @@index([userId, isEssential])
}

model Budget {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String
  month       String
  limitAmount Decimal  @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, category, month])
  @@index([userId, month])
}

model CollegeCommitment {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  amount      Decimal   @db.Decimal(12, 2)
  dueDate     DateTime
  priority    String    @default("HIGH")
  category    String    @default("Tuition")
  status      String    @default("UNPAID")
  paidAmount  Decimal   @default(0) @db.Decimal(12, 2)
  expenseId   String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, dueDate])
  @@index([userId, status])
}

model SavingsGoal {
  id            String                @id @default(uuid())
  userId        String
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  targetAmount  Decimal               @db.Decimal(12, 2)
  currentAmount Decimal               @default(0) @db.Decimal(12, 2)
  targetDate    DateTime
  category      String                @default("GENERAL")
  isCompleted   Boolean               @default(false)
  notes         String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  contributions SavingsContribution[]

  @@index([userId, isCompleted])
}

model SavingsContribution {
  id        String      @id @default(uuid())
  goalId    String
  goal      SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Decimal     @db.Decimal(12, 2)
  date      DateTime    @default(now())
  notes     String?
  createdAt DateTime    @default(now())

  @@index([goalId])
  @@index([userId])
}

model Reminder {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  dueDate     DateTime
  category    String   @default("COLLEGE_FEE")
  amount      Decimal? @db.Decimal(12, 2)
  isCompleted Boolean  @default(false)
  priority    String   @default("HIGH")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, dueDate])
  @@index([userId, isCompleted])
}

model LiteracyProgress {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId    String
  completed   Boolean   @default(false)
  quizScore   Int?      @default(0)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, moduleId])
  @@index([userId])
}
